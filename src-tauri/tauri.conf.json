{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Video Editor",
  "version": "0.1.0",
  "identifier": "dev.aivideoeditor.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AI Video Editor",
        "width": 1600,
        "height": 960,
        "minWidth": 1200,
        "minHeight": 700,
        "resizable": true,
        "theme": "Dark",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; media-src 'self' asset: http://asset.localhost blob:; img-src 'self' asset: http://asset.localhost data: blob:",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "publisher": "AI Video Editor",
    "shortDescription": "AI First Video Editor",
    "longDescription": "タイムライン型の動画編集UIに、AIによる素材解析と編集案生成を組み合わせた動画編集ソフト。",
    "category": "Video",
    "copyright": "",
    "resources": {
      "bin/": "bin/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Japanese",
          "English"
        ],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": [
          "ja-JP"
        ]
      }
    }
  }
}
